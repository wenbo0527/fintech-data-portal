{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "vue/setup-compiler-macros": true
  },
  "parser": "vue-eslint-parser",
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "parser": "@typescript-eslint/parser",
    "extraFileExtensions": [".vue"]
  },
  "plugins": ["vue", "@typescript-eslint"],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    ".vite/",
    ".cache/",
    "archive/",
    "scripts/_debug-archive/",
    "scripts/_test-archive-legacy/"
  ],
  "rules": {
    // ========== Vue 相关规则（宽松：优先类型检查） ==========
    "vue/multi-word-component-names": "off",
    "vue/no-unused-vars": "off",
    "vue/no-unused-components": "off",
    "vue/require-default-prop": "off",
    "vue/require-prop-types": "off",
    "vue/prop-name-casing": "off",
    "vue/component-name-in-template-casing": "off",
    "vue/no-side-effects-in-computed-properties": "off",
    "vue/no-mutating-props": "off",

    // 禁用格式类规则（统一交给 Prettier / 编辑器）
    "vue/max-attributes-per-line": "off",
    "vue/singleline-html-element-content-newline": "off",
    "vue/html-indent": "off",
    "vue/html-closing-bracket-newline": "off",
    "vue/first-attribute-linebreak": "off",
    "vue/multiline-html-element-content-newline": "off",
    "vue/attributes-order": "off",
    "vue/html-self-closing": "off",
    "vue/block-order": "off",

    // ========== TypeScript 相关规则（宽松：渐进严格） ==========
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "@typescript-eslint/ban-ts-comment": "off",
    "@typescript-eslint/no-inferrable-types": "off",

    // ========== 字节 + 阿里云代码规范核心规则 ==========
    "no-console": "warn",
    "no-debugger": "error",
    "no-alert": "error",
    "no-var": "error",
    "no-with": "error",
    "no-eval": "error",
    "no-new-wrappers": "error",
    "no-implied-eval": "error",
    "no-multi-str": "error",
    "no-proto": "error",
    "no-throw-literal": "error",
    "no-unused-expressions": "error",
    "no-useless-escape": "error",
    "no-duplicate-imports": "error",
    "no-array-constructor": "error",
    "no-new-object": "error",
    "array-callback-return": "error",
    "prefer-const": "error",
    "prefer-arrow-callback": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "prefer-promise-reject-errors": "error",
    "arrow-spacing": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "guard-for-in": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "radix": "error",
    "wrap-iife": ["error", "any"],
    "camelcase": ["error", { "properties": "never" }],
    "new-cap": "error",

    // ========== 复杂度限制（吸取 disabled 版 + 性能考虑） ==========
    "complexity": ["warn", 15],
    "max-depth": ["warn", 6],
    "max-lines-per-function": ["warn", { "max": 300, "skipComments": true, "skipBlankLines": true }],
    "max-params": ["warn", 6],
    "max-nested-callbacks": "off",
    "max-len": "off",
    "id-blacklist": "off",
    "require-await": "off",

    // ========== 格式规则（关闭：交给 Prettier） ==========
    "indent": "off",
    "quotes": "off",
    "semi": "off",
    "comma-dangle": "off",
    "object-curly-spacing": "off",
    "array-bracket-spacing": "off"
  },
  "overrides": [
    {
      "files": ["*.vue"],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["*.test.js", "*.spec.js", "*.test.ts", "*.spec.ts", "**/*.mock.js", "**/*.fixture.js"],
      "rules": {
        "no-console": "off",
        "no-debugger": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/**/*.js", "scripts/**/*.cjs", "scripts/**/*.mjs"],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "complexity": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["archive/legacy-src/**/*.vue", "archive/legacy-src/**/*.ts", "archive/legacy-src/**/*.js"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "max-depth": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
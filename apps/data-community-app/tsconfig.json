{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "paths": {
      "@/dfd-pages/*": ["../dfd-app/src/pages/*"],
      "@/types-dca/*": ["./src/types-dca/*"],
      "@/stores-dca/*": ["./src/stores-dca/*"],
      "@/mock-dca/*": ["./src/mock/*"],
      "@/mock-shared/*": ["./src/mock/shared/*"],
      "@/components-dca/*": ["./src/components-dca/*"],
      "@/utils-dca/*": ["./src/utils-dca/*"],
      "@/composables/*": ["./src/composables/*"],
      "@/config-dca/*": ["./src/config-dca/*"],
      "@mock-dca/*": ["./src/mock/*"],
      "@mock-shared/*": ["./src/mock/shared/*"],
      "@dca-components/*": ["./src/components-dca/*"],
      "@/stores/*": ["../dfd-app/src/stores/*"],
      "@/components/*": ["../dfd-app/src/components/*"],
      "@/api/*": ["../dfd-app/src/api/*"],
      "@/api/search-shim": ["./src/api/search-shim.ts"],
      "@/mock/metrics": ["../dfd-app/src/mock/metrics"],
      "@/mock/metrics.ts": ["../dfd-app/src/mock/metrics.ts"],
      "@/mock/community": ["../dfd-app/src/mock/community"],
      "@/mock/notification": ["../dfd-app/src/mock/notification"],
      "@/mock/data-map": ["../dfd-app/src/mock/data-map"],
      "@/mock/tableData": ["../dfd-app/src/mock/tableData"],
      "@/mock/tableData.ts": ["../dfd-app/src/mock/tableData.ts"],
      "@/mock/businessProcessData": ["../dfd-app/src/mock/businessProcessData"],
      "@/mock/businessModuleData": ["../dfd-app/src/mock/businessModuleData"],
      "@/mock/external-resources": ["../dfd-app/src/mock/external-resources"],
      "@/mock/external-data": ["../dfd-app/src/mock/external-data"],
      "@/types/*": ["../dfd-app/src/types/*"],
      "@/pages/*": ["../dfd-app/src/pages/*"],
      "@/router/*": ["../dfd-app/src/router/*"],
      "@/constants/*": ["../dfd-app/src/constants/*"],
      "@/utils/copy": ["../../packages/shared-utils/src/copy.ts"],
      "@/utils/message": ["../../packages/shared-utils/src/message.ts"],
      "@/utils/export": ["../../packages/shared-utils/src/export.ts"],
      "@/utils/coords": ["../../packages/shared-utils/src/coords.ts"],
      "@/utils/arco": ["../../packages/shared-utils/src/arco.ts"],
      "@/utils/validationUtils": ["../../packages/shared-utils/src/validationUtils.ts"],
      "@/utils/*": ["../dfd-app/src/utils/*"],
      "@/*": ["./src/*"],
      "@/mock/*": ["./src/mock/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.vue.js"
  ]
}
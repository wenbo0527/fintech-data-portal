{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@data-community/semantic-contract": ["../../packages/semantic-contract/src/index.ts"],
      "@data-community/semantic-contract/types": ["../../packages/semantic-contract/src/types.ts"],
      "@data-community/semantic-contract/query": ["../../packages/semantic-contract/src/query.ts"],
      "@data-community/semantic-contract/data/metrics": ["../../packages/semantic-contract/src/data/metrics.ts"],
      "@data-community/semantic-contract/data/knowledge": ["../../packages/semantic-contract/src/data/knowledge.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
